{
  "name": "german-step-by-step",
  "version": "1.0.0",
  "private": true,
  "description": "德語 Step by Step 國際版 - German Step by Step (International Edition)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:i18n": "vitest run tests/i18n.test.ts",
    "test:content": "vitest run tests/content.test.ts",
    "lint": "tsc --noEmit",
    "check:i18n": "vitest run tests/i18n.test.ts tests/content.test.ts",
    "check:locale": "node scripts/check-locales.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
